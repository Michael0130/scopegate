# ScopeGate environment template — PayPal SANDBOX credentials only.
# Never commit real values; never use live/production credentials in this project.

# --- PayPal (Sandbox) ---
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Optional: overrides config/webhook.json for the default seller's webhook id.
# PAYPAL_WEBHOOK_ID=your-webhook-id

# --- Additional sellers (config/sellers.json) — each settles into its OWN account ---
# Copy the sandbox credential pair from each seller's app in the developer dashboard.
# SELLER_BELLA_CLIENT_ID=your-bella-sandbox-client-id
# SELLER_BELLA_CLIENT_SECRET=your-bella-sandbox-client-secret
# SELLER_BELLA_WEBHOOK_ID=your-bella-webhook-id
# SELLER_CJ_CLIENT_ID=your-cj-sandbox-client-id
# SELLER_CJ_CLIENT_SECRET=your-cj-sandbox-client-secret
# SELLER_CJ_WEBHOOK_ID=your-cj-webhook-id

# --- Server ---
PORT=3000

# --- LLM provider (OpenAI-compatible) ---
# BigModel GLM Coding Plan keys: use https://open.bigmodel.cn/api/coding/paas/v4 with the
# coding-plan-specific key (regular open-platform keys bill separately and need balance).
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4.6
LLM_TIMEOUT_MS=4000
